NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://localhost:27017/erpFactory
REDIS_URL=redis://localhost:6379
JWT_SECRET=dev-jwt-secret-change-in-production
JWT_REFRESH_SECRET=dev-refresh-secret-change-in-production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
CORS_ORIGIN=http://localhost:5173,https://erp.khushpehno.com
# Comma-separated origins also supported, e.g. http://localhost:5173,https://erp.khushpehno.com
# In development, any http://localhost:<port> is allowed automatically
# Production also allows https://erp.khushpehno.com (and other https://*.khushpehno.com hosts)

# Optional email notifications (logs to console when SMTP not configured)
EMAIL_NOTIFICATIONS=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional S3 file storage (stub logs when not configured)
S3_BUCKET=
S3_REGION=ap-south-1

# Phone OTP (2Factor.in AUTOGEN). Without TWOFACTOR_API_KEY, local OTP is used in development only.
TWOFACTOR_API_KEY=
TWOFACTOR_OTP_TEMPLATE_NAME=OTPtemplate
TWOFACTOR_BASE_URL=https://2factor.in
REDIS_KEY_PREFIX=erp:
AUTH_OTP_REGISTER_ENABLED=false
AUTH_PHONE_OTP_ONLY=true

# Store-review bypass (disabled unless explicitly enabled)
APPLE_REVIEW_OTP_ENABLED=false
APPLE_REVIEW_PHONE=
APPLE_REVIEW_OTP=

# Cookies (SameSite=None + Secure is forced in production)
COOKIE_DOMAIN=
COOKIE_SAMESITE=lax

# Optional OTP rate-limit overrides
# OTP_RATE_LIMIT=30
# LOGIN_RATE_LIMIT=40
# VERIFY_OTP_RATE_LIMIT=40
# OTP_IP_SOFT_LIMIT=300

