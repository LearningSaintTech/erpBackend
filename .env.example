NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://localhost:27017/erpFactory
REDIS_URL=redis://localhost:6379
JWT_SECRET=dev-jwt-secret-change-in-production
JWT_REFRESH_SECRET=dev-refresh-secret-change-in-production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
CORS_ORIGIN=http://localhost:5173
# Comma-separated origins also supported, e.g. http://localhost:5173,http://localhost:5174
# In development, any http://localhost:<port> is allowed automatically

# Optional email notifications (logs to console when SMTP not configured)
EMAIL_NOTIFICATIONS=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional S3 file storage (stub logs when not configured)
S3_BUCKET=
S3_REGION=ap-south-1
